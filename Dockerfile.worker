# syntax=docker/dockerfile:1.7

FROM node:24-alpine
RUN apk add --no-cache libc6-compat tini
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.0.9 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml* .npmrc pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile || pnpm install
COPY . .

ENV NODE_ENV=production
ENTRYPOINT ["/sbin/tini", "--"]
# Not `pnpm worker:start`: that script hardcodes `tsx --env-file=.env`,
# which is for local dev where an actual .env file exists on disk. In the
# container there is no .env file (correctly git/dockerignored) --
# docker-compose's own `env_file:` directive already injects the same vars
# as real process env vars before this command runs, so --env-file would
# just fail looking for a file that was never meant to be here.
CMD ["pnpm", "exec", "tsx", "worker/index.ts"]
